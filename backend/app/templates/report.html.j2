<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Drug Discovery Report - {{ disease }}</title>
<style>
  :root {
    --bg: #0a0a0b; --fg: #e4e4e7; --muted: #71717a; --line: #27272a;
    --card: #111114; --accent: #34d399; --warn: #f59e0b; --bad: #f87171;
  }
  * { box-sizing: border-box; }
  body {
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--bg); color: var(--fg);
    max-width: 1080px; margin: 2.5em auto; padding: 0 1.5em;
    line-height: 1.6; font-size: 14.5px;
  }
  .doc-header { padding-bottom: 1.4em; border-bottom: 1px solid var(--line); margin-bottom: 2em; }
  .doc-header .label { color: var(--muted); font-size: 0.7em; letter-spacing: 0.2em; text-transform: uppercase; font-family: ui-monospace, monospace; margin-bottom: 0.4em; }
  .doc-header h1 { font-weight: 600; letter-spacing: -0.02em; font-size: 2em; margin: 0 0 0.5em; }
  .doc-header .meta { color: var(--muted); font-size: 0.85em; font-family: ui-monospace, monospace; }
  .doc-header .meta strong { color: var(--accent); font-weight: 500; }

  h2 { color: var(--accent); font-weight: 500; margin: 2.6em 0 0.8em; font-size: 0.78em; text-transform: uppercase; letter-spacing: 0.18em; font-family: ui-monospace, monospace; }
  p { margin: 0.6em 0; }

  .card { background: var(--card); border: 1px solid var(--line); padding: 1.2em 1.4em; border-radius: 6px; margin: 0.5em 0 1em; }

  .stats { display: flex; flex-wrap: wrap; gap: 2em 2.5em; margin-bottom: 1em; }
  .stat-label { color: var(--muted); font-size: 0.7em; text-transform: uppercase; letter-spacing: 0.16em; font-family: ui-monospace, monospace; margin-bottom: 0.3em; }
  .stat-value { font-size: 1.15em; font-weight: 500; color: var(--fg); }
  .stat-value.accent { color: var(--accent); font-family: ui-monospace, monospace; }

  table { border-collapse: collapse; width: 100%; margin: 0.5em 0; font-size: 0.92em; }
  th, td { border-bottom: 1px solid var(--line); padding: 0.7em 0.85em; text-align: left; vertical-align: top; }
  th { color: var(--muted); font-weight: 500; font-size: 0.7em; text-transform: uppercase; letter-spacing: 0.12em; font-family: ui-monospace, monospace; }
  td.rank { color: var(--muted); font-family: ui-monospace, monospace; width: 2em; text-align: right; padding-right: 1.2em; }
  td.smiles { font-family: ui-monospace, monospace; font-size: 0.78em; max-width: 360px; word-break: break-all; color: #a1a1aa; line-height: 1.5; }
  td.smiles strong { color: var(--fg); font-size: 1.1em; font-family: inherit; font-weight: 500; display: block; margin-bottom: 0.25em; }
  td.num { font-family: ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  td.affinity { color: var(--accent); font-weight: 500; }
  td.center { text-align: center; }

  .pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 0.7em; font-weight: 500; letter-spacing: 0.04em; font-family: ui-monospace, monospace; border: 1px solid; }
  .pill-fda { background: rgba(52, 211, 153, 0.15); color: var(--accent); border-color: rgba(52, 211, 153, 0.3); }
  .pill-novel { background: rgba(113, 113, 122, 0.1); color: var(--muted); border-color: var(--line); }
  .pill-pass { background: rgba(52, 211, 153, 0.1); color: var(--accent); border-color: rgba(52, 211, 153, 0.2); }
  .pill-fail { background: rgba(248, 113, 113, 0.1); color: var(--bad); border-color: rgba(248, 113, 113, 0.2); }
  .pill-easy { background: rgba(52, 211, 153, 0.15); color: var(--accent); border-color: rgba(52, 211, 153, 0.3); }
  .pill-mod { background: rgba(245, 158, 11, 0.12); color: var(--warn); border-color: rgba(245, 158, 11, 0.25); }
  .pill-hard { background: rgba(248, 113, 113, 0.12); color: var(--bad); border-color: rgba(248, 113, 113, 0.25); }

  .lead { color: var(--muted); font-size: 0.88em; margin: -0.4em 0 0.8em; }

  .rationale { color: var(--fg); font-size: 0.95em; line-height: 1.7; }
  .rationale p { margin: 0.7em 0; }
  .rationale h3 { color: var(--accent); font-size: 0.9em; font-weight: 500; margin: 1.4em 0 0.4em; text-transform: uppercase; letter-spacing: 0.1em; font-family: ui-monospace, monospace; }

  .footnote { color: var(--muted); font-size: 0.8em; border-top: 1px solid var(--line); padding-top: 1em; margin-top: 3em; line-height: 1.7; }
  .footnote strong { color: var(--fg); font-weight: 500; }
  .footnote .legend-row { margin: 0.5em 0; display: flex; align-items: center; gap: 0.5em; flex-wrap: wrap; }

  code { font-family: ui-monospace, monospace; font-size: 0.88em; color: #d4d4d8; }
</style>
</head>
<body>

<header class="doc-header">
  <div class="label">drug discovery report</div>
  <h1>{{ disease }}</h1>
  <div class="meta">
    <code>{{ job_id }}</code>
    &nbsp;&middot;&nbsp; generated {{ generated_at[:19] }}
    {% if confidence %}&nbsp;&middot;&nbsp; agent confidence <strong>{{ confidence }}</strong>{% endif %}
  </div>
</header>

{% if target %}
<h2>selected target</h2>
<div class="card">
  <div class="stats">
    <div>
      <div class="stat-label">uniprot</div>
      <div class="stat-value accent">{{ target.uniprot_id }}</div>
    </div>
    <div>
      <div class="stat-label">protein</div>
      <div class="stat-value">{{ target.protein_name }}</div>
    </div>
    {% if target.druggability_score is not none %}
    <div>
      <div class="stat-label">druggability</div>
      <div class="stat-value">{{ "%.3f"|format(target.druggability_score) }}</div>
    </div>
    {% endif %}
  </div>
  {% if target.rationale %}
  <p style="margin-top: 0.6em; color: var(--fg);">{{ target.rationale }}</p>
  {% endif %}
</div>
{% endif %}

{% if structure %}
<h2>structure</h2>
<div class="card">
  <div class="stats">
    <div>
      <div class="stat-label">source</div>
      <div class="stat-value accent">{{ structure.source }}</div>
    </div>
    {% if structure.quality_score and structure.quality_score > 0 %}
    <div>
      <div class="stat-label">{{ "pLDDT" if structure.source == "AlphaFold" else "quality" }}</div>
      <div class="stat-value">{{ "%.1f"|format(structure.quality_score) }}</div>
    </div>
    {% endif %}
    <div>
      <div class="stat-label">file</div>
      <div class="stat-value"><code>{{ structure.pdb_path }}</code></div>
    </div>
  </div>
</div>
{% endif %}

{% macro candidate_row(c) %}
<tr>
  <td class="rank">{{ c.rank }}</td>
  <td class="smiles">
    {% if c.molecule_name %}<strong>{{ c.molecule_name }}</strong>{% endif %}
    {{ c.molecule_smiles }}
  </td>
  <td class="num affinity">{{ "%.2f"|format(c.binding_affinity) }}</td>
  <td class="center">
    {% if c.lipinski_pass %}<span class="pill pill-pass">pass</span>
    {% elif c.lipinski_pass is sameas false %}<span class="pill pill-fail">fail</span>
    {% else %}<span style="color: var(--muted)">-</span>{% endif %}
  </td>
  <td class="center">
    {% if c.synthesis_score is not none %}
      {% set sa = c.synthesis_score %}
      <span class="pill {% if sa < 3.5 %}pill-easy{% elif sa < 6 %}pill-mod{% else %}pill-hard{% endif %}">{{ "%.1f"|format(sa) }}</span>
    {% else %}<span style="color: var(--muted)">-</span>{% endif %}
  </td>
  <td class="num">{{ "%.2f"|format(c.toxicity_score) if c.toxicity_score is not none else "-" }}</td>
  <td class="num">{{ "%.2f"|format(c.absorption_score) if c.absorption_score is not none else "-" }}</td>
  <td class="center">
    {% if c.is_approved_drug %}<span class="pill pill-fda">FDA</span>{% else %}<span class="pill pill-novel">novel</span>{% endif %}
  </td>
</tr>
{% endmacro %}

{% if approved_candidates %}
<h2>repurposing candidates (FDA-approved)</h2>
<p class="lead">Approved drugs with characterized PK and toxicity profiles. Fast-track repurposing leads with reduced clinical risk.</p>
<table>
  <thead>
    <tr><th>#</th><th>molecule</th><th>affinity</th><th>lipinski</th><th>SA</th><th>tox</th><th>abs</th><th>status</th></tr>
  </thead>
  <tbody>
    {% for c in approved_candidates %}{{ candidate_row(c) }}{% endfor %}
  </tbody>
</table>
{% endif %}

{% if novel_candidates %}
<h2>novel candidates</h2>
<p class="lead">Compounds without prior approval. Require full preclinical and clinical evaluation.</p>
<table>
  <thead>
    <tr><th>#</th><th>molecule</th><th>affinity</th><th>lipinski</th><th>SA</th><th>tox</th><th>abs</th><th>status</th></tr>
  </thead>
  <tbody>
    {% for c in novel_candidates %}{{ candidate_row(c) }}{% endfor %}
  </tbody>
</table>
{% endif %}

{% if not candidates %}
<h2>candidates</h2>
<p class="lead">No structured candidates were extracted from this run. See the agent rationale below.</p>
{% endif %}

{% if limitations %}
<h2>limitations</h2>
<div class="card">
  <p>{{ limitations }}</p>
</div>
{% endif %}

{% if summary_text %}
<h2>agent rationale</h2>
<div class="card">
  <div class="rationale">
    {{ summary_html | safe }}
  </div>
</div>
{% endif %}

<div class="footnote">
  <p><strong>Reading the synthesizability (SA) score</strong> &mdash; Ertl &amp; Schuffenhauer 2009. Lower is easier.</p>
  <div class="legend-row">
    <span class="pill pill-easy">&lt; 3.5 easy</span>
    <span class="pill pill-mod">3.5 - 6.0 moderate</span>
    <span class="pill pill-hard">&gt; 6.0 hard to synthesize</span>
  </div>
  <p style="margin-top: 1.2em;"><strong>Caveats.</strong> Docking affinity and ADMET scores in this report are computed via heuristic stubs (LogP/MW for docking; LogP/TPSA for ADMET). Pocket detection uses the structure centroid. For production use, replace with AutoDock Vina, ADMETlab2 or pkCSM, and fpocket or P2Rank respectively.</p>
</div>

</body>
</html>
